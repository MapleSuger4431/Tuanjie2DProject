crashlytics-build.properties
# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
# 美术资源（Assets/Art/ 等）走 Git LFS 正常追踪，不做整目录忽略
# 2D项目明确不用的文件（彻底排除）
/[Aa]ssets/**/*.fbx
/[Aa]ssets/**/*.obj
/[Aa]ssets/**/*.blend
/[Aa]ssets/**/*.gltf
/[Aa]ssets/**/*.glb
/[Aa]ssets/**/*.dae
/[Aa]ssets/**/*.exr
/[Aa]ssets/**/*.hdr
/[Aa]ssets/**/*.mp4
/[Aa]ssets/**/*.mov
/[Aa]ssets/**/*.webm
/[Aa]ssets/**/NavMesh*/
/[Aa]ssets/**/LightingData*/
/[Aa]ssets/**/ReflectionProbe*
# 本地工具产物（extensions 与 skills 需随仓库上传，仅忽略其余本地产物）
/.codely-cli/*
!/.codely-cli/extensions/
!/.codely-cli/skills/
/.codelyignore
/.codely/clipboard/
# 本地验证截图/录屏产物（不上传仓库）
/screenshots/
# Rider / ReSharper 本地文件（跨平台 IDE 差异，Unity 官方社区建议忽略）
_ReSharper.*
*.DotSettings.user
# 兜底：Assets 下的 .meta 必须提交，防止上方规则误伤
!/[Aa]ssets/**/*.meta
