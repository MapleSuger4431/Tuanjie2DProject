.br-surface {
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgb(27, 30, 38);
}

.br-surface--raised {
    background-color: rgb(35, 40, 50);
}

.br-surface--sunken {
    background-color: rgb(14, 16, 22);
}

.br-surface--sm {
    padding: 8px;
}

.br-surface--md {
    padding: 16px;
}

.br-surface--lg {
    padding: 24px;
}
