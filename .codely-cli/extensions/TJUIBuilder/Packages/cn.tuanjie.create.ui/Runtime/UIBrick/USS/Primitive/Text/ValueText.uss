.br-value-text {
    color: rgb(244, 246, 250);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.br-value-text--muted {
    color: rgb(168, 176, 196);
}

.br-value-text--disabled {
    color: rgba(244, 246, 250, 0.42);
}

.br-value-text--accent {
    color: rgb(86, 153, 255);
}

.br-value-text--sm {
    font-size: 12px;
}

.br-value-text--md {
    font-size: 14px;
}

.br-value-text--lg {
    font-size: 18px;
}

.br-value-text--xl {
    font-size: 30px;
}
