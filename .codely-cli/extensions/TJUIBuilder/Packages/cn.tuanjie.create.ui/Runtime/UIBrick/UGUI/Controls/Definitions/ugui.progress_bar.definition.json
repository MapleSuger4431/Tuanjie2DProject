{
  "brickId": "ugui.progress_bar",
  "layer": "primitive",
  "category": "display",
  "requiredComponents": ["Slider"],
  "childStructure": [
    { "name": "Background", "component": "Image", "anchorMin": [0, 0.25], "anchorMax": [1, 0.75], "sizeDelta": [0, 0], "anchoredPosition": [0, 0] },
    { "name": "FillArea", "component": "RectTransform", "anchorMin": [0, 0.25], "anchorMax": [1, 0.75], "sizeDelta": [-20, 0], "anchoredPosition": [-5, 0], "children": [
      { "name": "Fill", "component": "Image", "anchorMin": [0, 0], "anchorMax": [0, 1], "sizeDelta": [10, 0], "anchoredPosition": [0, 0] }
    ]},
    { "name": "HandleArea", "component": "RectTransform", "optional": true, "anchorMin": [0, 0], "anchorMax": [1, 1], "sizeDelta": [-20, 0], "anchoredPosition": [0, 0], "children": [
      { "name": "Handle", "component": "Image", "anchorMin": [0, 0], "anchorMax": [0, 1], "sizeDelta": [20, 0], "anchoredPosition": [0, 0] }
    ]},
    { "name": "Label", "component": "RectTransform", "optional": true, "children": [
      { "name": "Text", "component": "Text" }
    ]}
  ],
  "eventBindings": {},
  "bindingProps": {
    "value": { "target": "value", "runtimeType": "float" },
    "text": { "target": "GetComponentInChildren<Text>().text", "runtimeType": "string" },
    "visible": { "target": "gameObject.SetActive", "runtimeType": "bool" }
  },
  "parameters": {
    "width": { "handler": "SetSizeDelta", "axis": "x", "type": "float" },
    "height": { "handler": "SetSizeDelta", "axis": "y", "type": "float" },
    "direction": { "target": "GetComponent<Slider>().direction", "type": "Slider.Direction" },
    "minValue": { "target": "GetComponent<Slider>().minValue", "type": "float" },
    "maxValue": { "target": "GetComponent<Slider>().maxValue", "type": "float" },
    "value": { "target": "GetComponent<Slider>().value", "type": "float" },
    "wholeNumbers": { "target": "GetComponent<Slider>().wholeNumbers", "type": "bool" },
    "backgroundColor": { "target": "GetComponent<Image>().color", "child": "Background", "type": "Color" },
    "backgroundSprite": { "handler": "LoadSprite", "child": "Background", "type": "string" },
    "backgroundType": { "target": "GetComponent<Image>().type", "child": "Background", "type": "Image.Type" },
    "backgroundPreserveAspect": { "target": "GetComponent<Image>().preserveAspect", "child": "Background", "type": "bool" },
    "backgroundFillCenter": { "target": "GetComponent<Image>().fillCenter", "child": "Background", "type": "bool" },
    "backgroundPixelsPerUnitMultiplier": { "target": "GetComponent<Image>().pixelsPerUnitMultiplier", "child": "Background", "type": "float" },
    "fillColor": { "target": "GetComponent<Image>().color", "child": "Fill", "type": "Color" },
    "fillSprite": { "handler": "LoadSprite", "child": "Fill", "type": "string" },
    "fillType": { "target": "GetComponent<Image>().type", "child": "Fill", "type": "Image.Type", "default": "Filled" },
    "fillMethod": { "target": "GetComponent<Image>().fillMethod", "child": "Fill", "type": "Image.FillMethod", "default": "Horizontal" },
    "fillOrigin": { "target": "GetComponent<Image>().fillOrigin", "child": "Fill", "type": "int", "default": 0 },
    "fillPreserveAspect": { "target": "GetComponent<Image>().preserveAspect", "child": "Fill", "type": "bool" },
    "handle.active": { "handler": "SetActive", "child": "HandleArea", "component": "RectTransform", "type": "bool", "default": false },
    "handle.preserveAspect": { "target": "GetComponent<Image>().preserveAspect", "child": "Handle", "type": "bool" },
    "handle.width": { "handler": "SetSizeDelta", "child": "Handle", "axis": "x", "type": "int" },
    "handle.height": { "handler": "SetSizeDelta", "child": "Handle", "axis": "y", "type": "int" },
    "borderRadius": { "handler": "SetBorderRadius", "child": "Background", "type": "int" },
    "shadowEnabled": { "handler": "EnsureShadow", "child": "Background", "type": "bool" },
    "shadowColor": { "handler": "SetShadowProp", "child": "Background", "prop": "effectColor", "type": "Color" },
    "shadowDistance": { "handler": "SetShadowProp", "child": "Background", "prop": "effectDistance", "type": "Vector2" },
    "opacity": { "target": "GetComponent<CanvasGroup>().alpha", "type": "float" },
    "navigation.mode": { "target": "GetComponent<Slider>().navigation.mode", "type": "Navigation.Mode", "default": "Automatic" },
    "navigation.wrapAround": { "target": "GetComponent<Slider>().navigation.wrapAround", "type": "bool", "default": false },
    "transitionMode": { "target": "GetComponent<Slider>().transition", "type": "Selectable.Transition" },
    "tint.normalColor": { "target": "GetComponent<Slider>().colors.normalColor", "type": "Color" },
    "tint.highlightedColor": { "target": "GetComponent<Slider>().colors.highlightedColor", "type": "Color" },
    "tint.pressedColor": { "target": "GetComponent<Slider>().colors.pressedColor", "type": "Color" },
    "tint.selectedColor": { "target": "GetComponent<Slider>().colors.selectedColor", "type": "Color" },
    "tint.disabledColor": { "target": "GetComponent<Slider>().colors.disabledColor", "type": "Color" },
    "tint.fadeDuration": { "target": "GetComponent<Slider>().colors.fadeDuration", "type": "float" },
    "spriteSwap.highlightedSprite": { "target": "GetComponent<Slider>().spriteState.highlightedSprite", "type": "Sprite" },
    "spriteSwap.pressedSprite": { "target": "GetComponent<Slider>().spriteState.pressedSprite", "type": "Sprite" },
    "spriteSwap.selectedSprite": { "target": "GetComponent<Slider>().spriteState.selectedSprite", "type": "Sprite" },
    "spriteSwap.disabledSprite": { "target": "GetComponent<Slider>().spriteState.disabledSprite", "type": "Sprite" },
    "animation.normalTrigger": { "target": "GetComponent<Slider>().animationTriggers.normalTrigger", "type": "string" },
    "animation.highlightedTrigger": { "target": "GetComponent<Slider>().animationTriggers.highlightedTrigger", "type": "string" },
    "animation.pressedTrigger": { "target": "GetComponent<Slider>().animationTriggers.pressedTrigger", "type": "string" },
    "animation.selectedTrigger": { "target": "GetComponent<Slider>().animationTriggers.selectedTrigger", "type": "string" },
    "animation.disabledTrigger": { "target": "GetComponent<Slider>().animationTriggers.disabledTrigger", "type": "string" },
    "animation.animatorEnabled": { "handler": "EnsureAnimator", "type": "bool" },
    "animation.animatorControllerPath": { "handler": "LoadAnimatorController", "type": "string" },
    "label.active": { "handler": "SetActive", "child": "Label", "component": "RectTransform", "type": "bool", "default": true },
    "text": { "target": "GetComponentInChildren<Text>().text", "type": "string", "default": "" },
    "fontSize": { "target": "GetComponentInChildren<Text>().fontSize", "type": "int", "default": 14 },
    "fontStyle": { "target": "GetComponentInChildren<Text>().fontStyle", "type": "FontStyle" },
    "textColor": { "target": "GetComponentInChildren<Text>().color", "type": "Color", "default": [0.196, 0.196, 0.196, 1] },
    "textAlignment": { "target": "GetComponentInChildren<Text>().alignment", "type": "TextAnchor", "default": "MiddleCenter" },
    "lineSpacing": { "target": "GetComponentInChildren<Text>().lineSpacing", "type": "float" },
    "richText": { "target": "GetComponentInChildren<Text>().supportRichText", "type": "bool" },
    "raycastTarget": { "target": "GetComponentInChildren<Text>().raycastTarget", "type": "bool" },
    "horizontalOverflow": { "target": "GetComponentInChildren<Text>().horizontalOverflow", "type": "HorizontalWrapMode" },
    "verticalOverflow": { "target": "GetComponentInChildren<Text>().verticalOverflow", "type": "VerticalWrapMode" },
    "bestFit": { "target": "GetComponentInChildren<Text>().resizeTextForBestFit", "type": "bool" },
    "bestFitMinSize": { "target": "GetComponentInChildren<Text>().resizeTextMinSize", "type": "int" },
    "bestFitMaxSize": { "target": "GetComponentInChildren<Text>().resizeTextMaxSize", "type": "int" },
    "customFontPath": { "handler": "LoadFont", "type": "string" },
    "textShadowEnabled": { "handler": "EnsureShadow", "child": "Label/Text", "type": "bool" },
    "textShadowColor": { "handler": "SetShadowProp", "child": "Label/Text", "prop": "effectColor", "type": "Color" },
    "textShadowDistance": { "handler": "SetShadowProp", "child": "Label/Text", "prop": "effectDistance", "type": "Vector2" },
    "textOutlineEnabled": { "handler": "EnsureOutline", "child": "Label/Text", "type": "bool" },
    "textOutlineColor": { "handler": "SetOutlineProp", "child": "Label/Text", "prop": "effectColor", "type": "Color" },
    "textOutlineDistance": { "handler": "SetOutlineProp", "child": "Label/Text", "prop": "effectDistance", "type": "Vector2" },
    "anchorMin": { "target": "GetComponent<RectTransform>().anchorMin", "type": "Vector2" },
    "anchorMax": { "target": "GetComponent<RectTransform>().anchorMax", "type": "Vector2" },
    "pivot": { "target": "GetComponent<RectTransform>().pivot", "type": "Vector2" },
    "anchoredPosition": { "target": "GetComponent<RectTransform>().anchoredPosition", "type": "Vector2" },
    "localScale": { "target": "GetComponent<Transform>().localScale", "type": "Vector3" },
    "localRotation": { "target": "GetComponent<Transform>().localEulerAngles", "type": "Vector3" },
    "interactable": { "target": "interactable", "type": "bool" }
  },
  "compositionPolicy": {
    "allowedChildren": "none",
    "canNestUnder": ["ugui.stack_vertical", "ugui.stack_horizontal", "ugui.grid", "ugui.panel"]
  },
  "layoutContract": {
    "self": {
      "widthMode": ["hug", "fixed", "fill"],
      "heightMode": ["hug", "fixed"]
    }
  },
  "eventSchema": {},
  "aiSelectable": true,
  "aiPriority": "medium"
}
