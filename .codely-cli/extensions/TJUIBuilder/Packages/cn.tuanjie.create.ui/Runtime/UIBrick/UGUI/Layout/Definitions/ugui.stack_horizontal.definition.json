    "background.sizeDelta": { "target": "GetComponent<RectTransform>().sizeDelta", "child": "Background", "type": "Vector2" },
    "background.offsetMin": { "target": "GetComponent<RectTransform>().offsetMin", "child": "Background", "type": "Vector2" },
    "background.offsetMax": { "target": "GetComponent<RectTransform>().offsetMax", "child": "Background", "type": "Vector2" },
    "background.width": { "handler": "SetSizeDelta", "child": "Background", "axis": "x", "type": "float" },
    "background.height": { "handler": "SetSizeDelta", "child": "Background", "axis": "y", "type": "float" },
    "borderRadius": { "handler": "SetBorderRadius", "child": "Background", "type": "int" },
    "shadowEnabled": { "handler": "EnsureShadow", "child": "Background", "type": "bool" },
    "shadowColor": { "handler": "SetShadowProp", "child": "Background", "prop": "effectColor", "type": "Color" },
    "shadowDistance": { "handler": "SetShadowProp", "child": "Background", "prop": "effectDistance", "type": "Vector2" },
    "spacing": {
      "target": "spacing",
      "type": "float",
      "default": 4
    },
    "childAlignment": {
      "target": "childAlignment",
      "type": "TextAnchor",
      "default": "UpperLeft"
    },
    "childControlWidth": {
      "target": "childControlWidth",
      "type": "bool",
      "default": true
    },
    "childControlHeight": {
      "target": "childControlHeight",
      "type": "bool",
      "default": true
    },
    "padding": {
      "target": "padding",
      "type": "RectOffset",
      "default": [0, 0, 0, 0]
    },
    "childForceExpandWidth": {
      "target": "childForceExpandWidth",
      "type": "bool",
      "default": true
    },
    "childForceExpandHeight": {
      "target": "childForceExpandHeight",
      "type": "bool",
      "default": true
    },
    "childScaleWidth": {
      "target": "childScaleWidth",
      "type": "bool",
      "default": false
    },
    "childScaleHeight": {
      "target": "childScaleHeight",
      "type": "bool",
      "default": false
    },
    "reverseArrangement": {
      "target": "reverseArrangement",
      "type": "bool",
      "default": false
