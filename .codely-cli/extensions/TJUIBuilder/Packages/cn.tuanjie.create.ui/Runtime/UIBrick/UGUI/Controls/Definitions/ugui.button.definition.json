{
  "brickId": "ugui.button",
  "layer": "primitive",
  "category": "input",
  "requiredComponents": ["Button", "Text"],
  "childStructure": [
    { "name": "Background", "component": "Image", "ignoreLayout": true },
    { "name": "Icon", "component": "Image", "optional": true },
    { "name": "Label", "component": "Text" }
  ],
  "eventBindings": {
    "clicked": "onClick.AddListener"
  },
  "bindingProps": {
    "text": { "target": "GetComponentInChildren<Text>().text", "runtimeType": "string" },
    "visible": { "target": "gameObject.SetActive", "runtimeType": "bool" },
    "enabled": { "target": "interactable", "runtimeType": "bool" }
  },
  "parameters": {
    "width": { "handler": "SetSizeDelta", "axis": "x", "type": "float" },
    "height": { "handler": "SetSizeDelta", "axis": "y", "type": "float" },
    "backgroundSprite": { "handler": "LoadSprite", "child": "Background", "type": "string" },
    "backgroundColor": { "target": "GetComponent<Image>().color", "child": "Background", "type": "Color" },
    "backgroundType": { "target": "GetComponent<Image>().type", "child": "Background", "type": "Image.Type" },
    "background.preserveAspect": { "target": "GetComponent<Image>().preserveAspect", "child": "Background", "type": "bool" },
    "background.fillCenter": { "target": "GetComponent<Image>().fillCenter", "child": "Background", "type": "bool" },
    "background.pixelsPerUnitMultiplier": { "target": "GetComponent<Image>().pixelsPerUnitMultiplier", "child": "Background", "type": "float" },
    "background.anchorMin": { "target": "GetComponent<RectTransform>().anchorMin", "child": "Background", "type": "Vector2" },
    "background.anchorMax": { "target": "GetComponent<RectTransform>().anchorMax", "child": "Background", "type": "Vector2" },
    "background.pivot": { "target": "GetComponent<RectTransform>().pivot", "child": "Background", "type": "Vector2" },
    "background.anchoredPosition": { "target": "GetComponent<RectTransform>().anchoredPosition", "child": "Background", "type": "Vector2" },
    "background.sizeDelta": { "target": "GetComponent<RectTransform>().sizeDelta", "child": "Background", "type": "Vector2" },
    "background.offsetMin": { "target": "GetComponent<RectTransform>().offsetMin", "child": "Background", "type": "Vector2" },
    "background.offsetMax": { "target": "GetComponent<RectTransform>().offsetMax", "child": "Background", "type": "Vector2" },
    "background.width": { "handler": "SetSizeDelta", "child": "Background", "axis": "x", "type": "float" },
    "background.height": { "handler": "SetSizeDelta", "child": "Background", "axis": "y", "type": "float" },
    "borderRadius": { "handler": "SetBorderRadius", "child": "Background", "type": "int" },
    "shadowEnabled": { "handler": "EnsureShadow", "child": "Background", "type": "bool" },
    "shadowColor": { "handler": "SetShadowProp", "child": "Background", "prop": "effectColor", "type": "Color" },
    "shadowDistance": { "handler": "SetShadowProp", "child": "Background", "prop": "effectDistance", "type": "Vector2" },
    "opacity": { "target": "GetComponent<CanvasGroup>().alpha", "type": "float" },
    "navigation.mode": { "target": "GetComponent<Button>().navigation.mode", "type": "Navigation.Mode", "default": "Automatic" },
    "navigation.wrapAround": { "target": "GetComponent<Button>().navigation.wrapAround", "type": "bool", "default": false },
    "transitionMode": { "target": "GetComponent<Button>().transition", "type": "Selectable.Transition" },
    "tint.normalColor": { "target": "GetComponent<Button>().colors.normalColor", "type": "Color" },
    "tint.highlightedColor": { "target": "GetComponent<Button>().colors.highlightedColor", "type": "Color" },
    "tint.pressedColor": { "target": "GetComponent<Button>().colors.pressedColor", "type": "Color" },
    "tint.selectedColor": { "target": "GetComponent<Button>().colors.selectedColor", "type": "Color" },
    "tint.disabledColor": { "target": "GetComponent<Button>().colors.disabledColor", "type": "Color" },
    "tint.fadeDuration": { "target": "GetComponent<Button>().colors.fadeDuration", "type": "float" },
    "spriteSwap.highlightedSprite": { "target": "GetComponent<Button>().spriteState.highlightedSprite", "type": "Sprite" },
    "spriteSwap.pressedSprite": { "target": "GetComponent<Button>().spriteState.pressedSprite", "type": "Sprite" },
    "spriteSwap.selectedSprite": { "target": "GetComponent<Button>().spriteState.selectedSprite", "type": "Sprite" },
    "spriteSwap.disabledSprite": { "target": "GetComponent<Button>().spriteState.disabledSprite", "type": "Sprite" },
    "animation.normalTrigger": { "target": "GetComponent<Button>().animationTriggers.normalTrigger", "type": "string" },
    "animation.highlightedTrigger": { "target": "GetComponent<Button>().animationTriggers.highlightedTrigger", "type": "string" },
    "animation.pressedTrigger": { "target": "GetComponent<Button>().animationTriggers.pressedTrigger", "type": "string" },
    "animation.selectedTrigger": { "target": "GetComponent<Button>().animationTriggers.selectedTrigger", "type": "string" },
    "animation.disabledTrigger": { "target": "GetComponent<Button>().animationTriggers.disabledTrigger", "type": "string" },
    "animation.animatorEnabled": { "handler": "EnsureAnimator", "type": "bool" },
    "animation.animatorControllerPath": { "handler": "LoadAnimatorController", "type": "string" },
    "text": { "target": "GetComponentInChildren<Text>().text", "type": "string", "default": "Button" },
    "fontSize": { "target": "GetComponentInChildren<Text>().fontSize", "type": "int" },
    "fontStyle": { "target": "GetComponentInChildren<Text>().fontStyle", "type": "FontStyle" },
    "textColor": { "target": "GetComponentInChildren<Text>().color", "type": "Color" },
    "textAlignment": { "target": "GetComponentInChildren<Text>().alignment", "type": "TextAnchor" },
    "lineSpacing": { "target": "GetComponentInChildren<Text>().lineSpacing", "type": "float" },
    "richText": { "target": "GetComponentInChildren<Text>().supportRichText", "type": "bool" },
    "raycastTarget": { "target": "GetComponentInChildren<Text>().raycastTarget", "type": "bool" },
    "horizontalOverflow": { "target": "GetComponentInChildren<Text>().horizontalOverflow", "type": "HorizontalWrapMode" },
    "verticalOverflow": { "target": "GetComponentInChildren<Text>().verticalOverflow", "type": "VerticalWrapMode" },
    "bestFit": { "target": "GetComponentInChildren<Text>().resizeTextForBestFit", "type": "bool" },
    "bestFitMinSize": { "target": "GetComponentInChildren<Text>().resizeTextMinSize", "type": "int" },
    "bestFitMaxSize": { "target": "GetComponentInChildren<Text>().resizeTextMaxSize", "type": "int" },
    "textShadowEnabled": { "handler": "EnsureShadow", "child": "Label", "type": "bool" },
    "textShadowColor": { "handler": "SetShadowProp", "child": "Label", "prop": "effectColor", "type": "Color" },
    "textShadowDistance": { "handler": "SetShadowProp", "child": "Label", "prop": "effectDistance", "type": "Vector2" },
    "textOutlineEnabled": { "handler": "EnsureOutline", "child": "Label", "type": "bool" },
    "textOutlineColor": { "handler": "SetOutlineProp", "child": "Label", "prop": "effectColor", "type": "Color" },
    "textOutlineDistance": { "handler": "SetOutlineProp", "child": "Label", "prop": "effectDistance", "type": "Vector2" },
    "customFontPath": { "handler": "LoadFont", "type": "string" },
    "icon.spritePath": { "handler": "LoadSprite", "child": "Icon", "type": "string" },
    "icon.width": { "handler": "SetSizeDelta", "child": "Icon", "axis": "x", "type": "int" },
    "icon.height": { "handler": "SetSizeDelta", "child": "Icon", "axis": "y", "type": "int" },
    "icon.position": { "handler": "SetIconLayout", "prop": "position", "type": "string" },
    "icon.margin": { "handler": "SetIconLayout", "prop": "margin", "type": "int" },
    "icon.color": { "target": "GetComponent<Image>().color", "child": "Icon", "type": "Color" },
    "icon.preserveAspect": { "target": "GetComponent<Image>().preserveAspect", "child": "Icon", "type": "bool" },
    "icon.active": { "handler": "SetActive", "child": "Icon", "component": "Image", "type": "bool" },
    "effects.enabled": { "handler": "SetScaleEffect", "prop": "enabled", "type": "bool" },
    "effects.pressScale": { "handler": "SetScaleEffect", "prop": "pressScale", "type": "Vector3" },
    "effects.pressScaleDuration": { "handler": "SetScaleEffect", "prop": "pressScaleDuration", "type": "float" },
    "effects.hoverScale": { "handler": "SetScaleEffect", "prop": "hoverScale", "type": "Vector3" },
    "effects.hoverScaleDuration": { "handler": "SetScaleEffect", "prop": "hoverScaleDuration", "type": "float" },
    "anchorMin": { "target": "GetComponent<RectTransform>().anchorMin", "type": "Vector2" },
    "anchorMax": { "target": "GetComponent<RectTransform>().anchorMax", "type": "Vector2" },
    "pivot": { "target": "GetComponent<RectTransform>().pivot", "type": "Vector2" },
    "anchoredPosition": { "target": "GetComponent<RectTransform>().anchoredPosition", "type": "Vector2" },
    "localScale": { "target": "GetComponent<Transform>().localScale", "type": "Vector3" },
    "interactable": { "target": "interactable", "type": "bool" }
  },
  "compositionPolicy": {
    "allowedChildren": "none",
    "canNestUnder": ["ugui.stack_vertical", "ugui.stack_horizontal", "ugui.grid", "ugui.modal", "ugui.panel"]
  },
  "layoutContract": {
    "self": {
      "widthMode": ["hug", "fixed", "fill"],
      "heightMode": ["hug", "fixed"]
    }
  },
  "eventSchema": {
    "clicked": "ui_event"
  },
  "aiSelectable": true,
  "aiPriority": "high"
}
