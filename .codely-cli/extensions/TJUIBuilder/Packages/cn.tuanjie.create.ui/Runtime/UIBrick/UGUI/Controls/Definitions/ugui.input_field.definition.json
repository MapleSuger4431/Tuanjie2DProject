{
  "brickId": "ugui.input_field",
  "layer": "primitive",
  "category": "input",
  "requiredComponents": ["InputField"],
  "childStructure": [
    { "name": "Label", "component": "Text", "optional": true },
    { "name": "Input Area", "component": "RectTransform", "anchorMin": [0, 0], "anchorMax": [1, 1], "sizeDelta": [0, 0], "anchoredPosition": [0, 0], "pivot": [0.5, 0.5], "children": [
      { "name": "Background", "component": "Image", "anchorMin": [0, 0], "anchorMax": [1, 1], "sizeDelta": [0, 0], "anchoredPosition": [0, 0], "pivot": [0.5, 0.5] },
      { "name": "Text Area", "component": "RectTransform", "anchorMin": [0, 0], "anchorMax": [1, 1], "sizeDelta": [0, 0], "anchoredPosition": [0, 0], "pivot": [0.5, 0.5], "children": [
        { "name": "Placeholder", "component": "Text", "anchorMin": [0, 0], "anchorMax": [1, 1], "sizeDelta": [-20, -13], "anchoredPosition": [0, -0.5] },
        { "name": "Text", "component": "Text", "anchorMin": [0, 0], "anchorMax": [1, 1], "sizeDelta": [-20, -13], "anchoredPosition": [0, -0.5] }
      ]}
    ]}
  ],
  "eventBindings": {
    "changed": "onEndEdit.AddListener",
    "valueChanged": "onValueChanged.AddListener"
  },
  "bindingProps": {
    "text": { "target": "text", "runtimeType": "string" },
    "visible": { "target": "gameObject.SetActive", "runtimeType": "bool" },
    "enabled": { "target": "interactable", "runtimeType": "bool" }
  },
  "parameters": {
    "width": { "handler": "SetSizeDelta", "axis": "x", "type": "float" },
    "height": { "handler": "SetSizeDelta", "axis": "y", "type": "float" },
    "backgroundSprite": { "handler": "LoadSprite", "child": "Background", "type": "string" },
    "backgroundColor": { "target": "GetComponent<Image>().color", "child": "Background", "type": "Color" },
    "backgroundType": { "target": "GetComponent<Image>().type", "child": "Background", "type": "Image.Type" },
    "background.preserveAspect": { "target": "GetComponent<Image>().preserveAspect", "child": "Background", "type": "bool" },
    "background.fillCenter": { "target": "GetComponent<Image>().fillCenter", "child": "Background", "type": "bool" },
    "background.pixelsPerUnitMultiplier": { "target": "GetComponent<Image>().pixelsPerUnitMultiplier", "child": "Background", "type": "float" },
    "background.anchorMin": { "target": "GetComponent<RectTransform>().anchorMin", "child": "Background", "type": "Vector2" },
    "background.anchorMax": { "target": "GetComponent<RectTransform>().anchorMax", "child": "Background", "type": "Vector2" },
    "background.pivot": { "target": "GetComponent<RectTransform>().pivot", "child": "Background", "type": "Vector2" },
    "background.anchoredPosition": { "target": "GetComponent<RectTransform>().anchoredPosition", "child": "Background", "type": "Vector2" },
    "background.sizeDelta": { "target": "GetComponent<RectTransform>().sizeDelta", "child": "Background", "type": "Vector2" },
    "background.offsetMin": { "target": "GetComponent<RectTransform>().offsetMin", "child": "Background", "type": "Vector2" },
    "background.offsetMax": { "target": "GetComponent<RectTransform>().offsetMax", "child": "Background", "type": "Vector2" },
    "background.width": { "handler": "SetSizeDelta", "child": "Background", "axis": "x", "type": "float" },
    "background.height": { "handler": "SetSizeDelta", "child": "Background", "axis": "y", "type": "float" },
    "borderRadius": { "handler": "SetBorderRadius", "child": "Background", "type": "int" },
    "shadowEnabled": { "handler": "EnsureShadow", "child": "Background", "type": "bool" },
    "shadowColor": { "handler": "SetShadowProp", "child": "Background", "prop": "effectColor", "type": "Color" },
    "shadowDistance": { "handler": "SetShadowProp", "child": "Background", "prop": "effectDistance", "type": "Vector2" },
    "opacity": { "target": "GetComponent<CanvasGroup>().alpha", "type": "float" },
    "navigation.mode": { "target": "GetComponent<InputField>().navigation.mode", "type": "Navigation.Mode", "default": "Automatic" },
    "navigation.wrapAround": { "target": "GetComponent<InputField>().navigation.wrapAround", "type": "bool", "default": false },
    "transitionMode": { "target": "GetComponent<InputField>().transition", "type": "Selectable.Transition" },
    "tint.normalColor": { "target": "GetComponent<InputField>().colors.normalColor", "type": "Color" },
    "tint.highlightedColor": { "target": "GetComponent<InputField>().colors.highlightedColor", "type": "Color" },
    "tint.pressedColor": { "target": "GetComponent<InputField>().colors.pressedColor", "type": "Color" },
    "tint.selectedColor": { "target": "GetComponent<InputField>().colors.selectedColor", "type": "Color" },
    "tint.disabledColor": { "target": "GetComponent<InputField>().colors.disabledColor", "type": "Color" },
    "tint.fadeDuration": { "target": "GetComponent<InputField>().colors.fadeDuration", "type": "float" },
    "spriteSwap.highlightedSprite": { "target": "GetComponent<InputField>().spriteState.highlightedSprite", "type": "Sprite" },
    "spriteSwap.pressedSprite": { "target": "GetComponent<InputField>().spriteState.pressedSprite", "type": "Sprite" },
    "spriteSwap.selectedSprite": { "target": "GetComponent<InputField>().spriteState.selectedSprite", "type": "Sprite" },
    "spriteSwap.disabledSprite": { "target": "GetComponent<InputField>().spriteState.disabledSprite", "type": "Sprite" },
    "animation.normalTrigger": { "target": "GetComponent<InputField>().animationTriggers.normalTrigger", "type": "string" },
    "animation.highlightedTrigger": { "target": "GetComponent<InputField>().animationTriggers.highlightedTrigger", "type": "string" },
    "animation.pressedTrigger": { "target": "GetComponent<InputField>().animationTriggers.pressedTrigger", "type": "string" },
    "animation.selectedTrigger": { "target": "GetComponent<InputField>().animationTriggers.selectedTrigger", "type": "string" },
    "animation.disabledTrigger": { "target": "GetComponent<InputField>().animationTriggers.disabledTrigger", "type": "string" },
    "animation.animatorEnabled": { "handler": "EnsureAnimator", "type": "bool" },
    "animation.animatorControllerPath": { "handler": "LoadAnimatorController", "type": "string" },
    "text": { "target": "text", "type": "string", "default": "" },
    "contentType": { "target": "contentType", "type": "InputField.ContentType" },
    "lineType": { "target": "lineType", "type": "InputField.LineType" },
    "characterLimit": { "target": "characterLimit", "type": "int" },
    "caretColor": { "target": "caretColor", "type": "Color" },
    "customCaretColor": { "target": "customCaretColor", "type": "bool" },
    "selectionColor": { "target": "selectionColor", "type": "Color" },
    "caretBlinkRate": { "target": "caretBlinkRate", "type": "float" },
    "caretWidth": { "target": "caretWidth", "type": "int" },
    "customFontPath": { "handler": "LoadFont", "type": "string" },
    "fontSize": { "target": "GetComponent<Text>().fontSize", "child": "Text", "type": "int" },
    "fontStyle": { "target": "GetComponent<Text>().fontStyle", "child": "Text", "type": "FontStyle" },
    "textColor": { "target": "GetComponent<Text>().color", "child": "Text", "type": "Color" },
    "textAlignment": { "target": "GetComponent<Text>().alignment", "child": "Text", "type": "TextAnchor", "default": "MiddleLeft" },
    "lineSpacing": { "target": "GetComponent<Text>().lineSpacing", "child": "Text", "type": "float" },
    "richText": { "target": "GetComponent<Text>().supportRichText", "child": "Text", "type": "bool" },
    "raycastTarget": { "target": "GetComponent<Text>().raycastTarget", "child": "Text", "type": "bool" },
    "horizontalOverflow": { "target": "GetComponent<Text>().horizontalOverflow", "child": "Text", "type": "HorizontalWrapMode" },
    "verticalOverflow": { "target": "GetComponent<Text>().verticalOverflow", "child": "Text", "type": "VerticalWrapMode" },
    "bestFit": { "target": "GetComponent<Text>().resizeTextForBestFit", "child": "Text", "type": "bool" },
    "bestFitMinSize": { "target": "GetComponent<Text>().resizeTextMinSize", "child": "Text", "type": "int" },
    "bestFitMaxSize": { "target": "GetComponent<Text>().resizeTextMaxSize", "child": "Text", "type": "int" },
    "textShadowEnabled": { "handler": "EnsureShadow", "child": "Text", "type": "bool" },
    "textShadowColor": { "handler": "SetShadowProp", "child": "Text", "prop": "effectColor", "type": "Color" },
    "textShadowDistance": { "handler": "SetShadowProp", "child": "Text", "prop": "effectDistance", "type": "Vector2" },
    "textOutlineEnabled": { "handler": "EnsureOutline", "child": "Text", "type": "bool" },
    "textOutlineColor": { "handler": "SetOutlineProp", "child": "Text", "prop": "effectColor", "type": "Color" },
    "textOutlineDistance": { "handler": "SetOutlineProp", "child": "Text", "prop": "effectDistance", "type": "Vector2" },
    "placeholderText": { "target": "GetComponent<Text>().text", "child": "Placeholder", "type": "string", "default": "Enter text..." },
    "placeholderColor": { "target": "GetComponent<Text>().color", "child": "Placeholder", "type": "Color" },
    "placeholderFontSize": { "target": "GetComponent<Text>().fontSize", "child": "Placeholder", "type": "int" },
    "label.active": { "handler": "SetActive", "child": "Label", "component": "Text", "type": "bool", "default": false },
    "label.position": { "handler": "SetLabelLayout", "prop": "position", "type": "string", "default": "left" },
    "label.spacing": { "handler": "SetLabelLayout", "prop": "spacing", "type": "float", "default": 8 },
    "label.text": { "target": "GetComponent<Text>().text", "child": "Label", "type": "string", "default": "" },
    "label.fontSize": { "target": "GetComponent<Text>().fontSize", "child": "Label", "type": "int", "default": 14 },
    "label.fontStyle": { "target": "GetComponent<Text>().fontStyle", "child": "Label", "type": "FontStyle" },
    "label.textColor": { "target": "GetComponent<Text>().color", "child": "Label", "type": "Color", "default": [0.196, 0.196, 0.196, 1] },
    "label.textAlignment": { "target": "GetComponent<Text>().alignment", "child": "Label", "type": "TextAnchor", "default": "MiddleCenter" },
    "label.lineSpacing": { "target": "GetComponent<Text>().lineSpacing", "child": "Label", "type": "float" },
    "label.richText": { "target": "GetComponent<Text>().supportRichText", "child": "Label", "type": "bool" },
    "label.raycastTarget": { "target": "GetComponent<Text>().raycastTarget", "child": "Label", "type": "bool" },
    "label.horizontalOverflow": { "target": "GetComponent<Text>().horizontalOverflow", "child": "Label", "type": "HorizontalWrapMode" },
    "label.verticalOverflow": { "target": "GetComponent<Text>().verticalOverflow", "child": "Label", "type": "VerticalWrapMode" },
    "label.bestFit": { "target": "GetComponent<Text>().resizeTextForBestFit", "child": "Label", "type": "bool" },
    "label.bestFitMinSize": { "target": "GetComponent<Text>().resizeTextMinSize", "child": "Label", "type": "int" },
    "label.bestFitMaxSize": { "target": "GetComponent<Text>().resizeTextMaxSize", "child": "Label", "type": "int" },
    "label.width": { "handler": "SetFlexTextProp", "child": "Label", "prop": "preferredWidth", "type": "float" },
    "label.flexibleWidth": { "handler": "SetFlexTextProp", "child": "Label", "prop": "flexibleWidth", "type": "float" },
    "label.minWidth": { "handler": "SetFlexTextProp", "child": "Label", "prop": "minWidth", "type": "float" },
    "label.textShadowEnabled": { "handler": "EnsureShadow", "child": "Label", "type": "bool" },
    "label.textShadowColor": { "handler": "SetShadowProp", "child": "Label", "prop": "effectColor", "type": "Color" },
    "label.textShadowDistance": { "handler": "SetShadowProp", "child": "Label", "prop": "effectDistance", "type": "Vector2" },
    "label.textOutlineEnabled": { "handler": "EnsureOutline", "child": "Label", "type": "bool" },
    "label.textOutlineColor": { "handler": "SetOutlineProp", "child": "Label", "prop": "effectColor", "type": "Color" },
    "label.textOutlineDistance": { "handler": "SetOutlineProp", "child": "Label", "prop": "effectDistance", "type": "Vector2" },
    "anchorMin": { "target": "GetComponent<RectTransform>().anchorMin", "type": "Vector2" },
    "anchorMax": { "target": "GetComponent<RectTransform>().anchorMax", "type": "Vector2" },
    "pivot": { "target": "GetComponent<RectTransform>().pivot", "type": "Vector2" },
    "anchoredPosition": { "target": "GetComponent<RectTransform>().anchoredPosition", "type": "Vector2" },
    "localScale": { "target": "GetComponent<Transform>().localScale", "type": "Vector3" },
    "localRotation": { "target": "GetComponent<Transform>().localEulerAngles", "type": "Vector3" },
    "interactable": { "target": "interactable", "type": "bool" }
  },
  "compositionPolicy": {
    "allowedChildren": "none",
    "canNestUnder": ["ugui.stack_vertical", "ugui.stack_horizontal", "ugui.grid", "ugui.panel"]
  },
  "layoutContract": {
    "self": {
      "widthMode": ["hug", "fixed", "fill"],
      "heightMode": ["hug", "fixed"]
    }
  },
  "eventSchema": {
    "changed": "ui_event",
    "valueChanged": "ui_event"
  },
  "aiSelectable": true,
  "aiPriority": "high"
}
